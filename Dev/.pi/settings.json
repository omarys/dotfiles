{
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultProvider": "opencode-go",
    "defaultModel": "opencode-go/deepseek-v4.1-flash",
    "defaultThinking": "low",
    "projectRootResolution": "git-root",
    "parallel": {
      "maxTasks": 4,
      "concurrency": 2
    },
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "worker": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "medium"
      },
      "researcher": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "reviewer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high"
      },
      "evidence-auditor": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "oracle": {
        "model": "antigravity/gemini-4-argon",
        "thinking": "high"
      },
      "advisor": {
        "model": "antigravity/gemini-4-argon",
        "thinking": "high"
      },
      "delegate": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["inherit", "opencode-go/*", "antigravity/*"]
    }
  }
}
