# Agent auth, runtime state, logs, and generated data.
# Codex is an allowlist: new runtime files stay untracked by default.
/.codex/*
!/.codex/AGENTS.md
!/.codex/CONTEXT-MODE.md
!/.codex/REKAL.md
!/.codex/RTK.md
!/.codex/config.toml.example
!/.codex/hooks.json
!/.codex/skills/
/.codex/skills/*
!/.codex/skills/grill-me/
!/.codex/skills/security-best-practices/

# Generated Python artifacts anywhere in the checkout.
__pycache__/
*.py[cod]

