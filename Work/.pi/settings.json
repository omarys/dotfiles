{
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-4-argon",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "antigravity/gemini-3.8-flash",
    "defaultThinking": "low",
    "projectRootResolution": "git-root",
    "parallel": {
      "maxTasks": 4,
      "concurrency": 2
    },
    "agentOverrides": {
      "scout": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "low"
      },
      "worker": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "medium"
      },
      "researcher": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "antigravity/gemini-4-hydrogen",
        "thinking": "medium"
      },
      "evidence-auditor": {
        "model": "antigravity/gemini-4-hydrogen",
        "thinking": "low"
      },
      "oracle": {
        "model": "antigravity/gemini-4-carbon",
        "thinking": "high"
      },
      "advisor": {
        "model": "antigravity/gemini-4-carbon",
        "thinking": "high"
      },
      "delegate": {
        "model": "antigravity/gemini-4-hydrogen",
        "thinking": "medium"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["inherit", "antigravity/*", "openai-codex/*"]
    }
  }
}
