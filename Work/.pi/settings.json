{
  "defaultProvider": "openai-codex",
  "defaultModel": "openai-codex/gpt-5.6-sol",
  "defaultThinkingLevel": "medium",

  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-sol": "medium",
    "openai-codex/gpt-5.6-luna": "low"
  },

  "subagents": {
    "defaultProvider": "openai-codex",
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "low",
    "maxThinking": "max",

    "agentOverrides": {
      "planner": {
        "model": "inherit",
        "thinking": "medium"
      },
      "oracle": {
        "model": "inherit",
        "thinking": "high"
      },
      "reviewer": {
        "model": "inherit",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low"
      }
    },

    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["inherit", "openai-codex/*"]
    }
  }
}
