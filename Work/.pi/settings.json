{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "defaultThinking": "low",
    "projectRootResolution": "git-root",
    "parallel": {
      "maxTasks": 4,
      "concurrency": 2
    },
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low"
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium"
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "low"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      },
      "advisor": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["inherit", "openai-codex/*", "antigravity/*"]
    }
  }
}
