// Dracula theme for broot
// https://draculatheme.com/contribute
skin: {
	default: "rgb(248, 248, 242) rgb(40, 42, 54) / rgb(248, 248, 242) rgb(68, 71, 90)"  // fg bg / fg current_line
	tree: "rgb(98, 114, 164) none"                                                     // comment
	file: "none none"                                                                  // default default
	directory: "rgb(139, 233, 253) none bold"                                         // cyan bold
	exe: "rgb(80, 250, 123) none"                                                      // green
	link: "rgb(255, 121, 198) none"                                                    // pink
	pruning: "rgb(98, 114, 164) none italic"                                           // comment italic
	perm__: "rgb(98, 114, 164) none"                                                   // comment
	perm_r: "none none"
	perm_w: "none none"
	perm_x: "none none"
	owner: "rgb(98, 114, 164) none"
	group: "rgb(98, 114, 164) none"
	sparse: "none none"
	git_branch: "rgb(189, 147, 249) none"                                             // purple
	git_insertions: "rgb(80, 250, 123) none"                                           // green
	git_deletions: "rgb(255, 85, 85) none"                                             // red
	git_status_current: "none none"
	git_status_modified: "rgb(241, 250, 140) none"                                     // yellow
	git_status_new: "rgb(80, 250, 123) none"                                           // green
	git_status_ignored: "rgb(98, 114, 164) none"                                       // comment
	git_status_conflicted: "rgb(255, 85, 85) none"                                     // red
	git_status_other: "rgb(255, 85, 85) none"                                          // red
	selected_line: "none rgb(68, 71, 90)"                                              // current_line
	char_match: "rgb(241, 250, 140) none underlined"                                   // yellow underlined
	file_error: "rgb(255, 184, 108) none italic"                                       // orange italic
	flag_label: "none none"
	flag_value: "rgb(255, 121, 198) none bold"                                         // pink bold
	input: "none none"
	status_error: "rgb(255, 85, 85) rgb(68, 71, 90)"                                   // red current_line
	status_job: "rgb(80, 250, 123) rgb(68, 71, 90) bold"                               // green current_line bold
	status_normal: "none rgb(68, 71, 90)"                                              // current_line
	status_italic: "rgb(241, 250, 140) rgb(68, 71, 90)"                                // yellow current_line
	status_bold: "rgb(248, 248, 242) rgb(68, 71, 90) bold"                             // fg current_line bold
	status_code: "rgb(189, 147, 249) rgb(68, 71, 90)"                                  // purple current_line
	status_ellipsis: "none rgb(68, 71, 90)"                                            // current_line
	scrollbar_track: "rgb(68, 71, 90) none"                                            // current_line
	scrollbar_thumb: "none none"
	help_paragraph: "none none"
	help_bold: "rgb(248, 248, 242) none bold"                                          // fg bold
	help_italic: "rgb(248, 248, 242) none italic"                                      // fg italic
	help_code: "rgb(248, 248, 242) rgb(68, 71, 90)"                                    // fg current_line
	help_headers: "rgb(241, 250, 140) none"                                            // yellow
	help_table_border: "none none"
	preview_title: "gray(20) rgb(40, 42, 54)"
	staging_area_title: "gray(22) rgb(40, 42, 54)"
 	good_to_bad_0: "ansi(42)"                                                         // green
 	good_to_bad_1: "ansi(42)"
 	good_to_bad_2: "ansi(42)"
 	good_to_bad_3: "ansi(42)"
 	good_to_bad_4: "ansi(42)"
 	good_to_bad_5: "ansi(178)"
 	good_to_bad_6: "ansi(172)"
 	good_to_bad_7: "ansi(166)"
 	good_to_bad_8: "ansi(160)"
 	good_to_bad_9: "ansi(196)"                                                        // red
}
